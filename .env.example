# Скопируйте в .env (файл .env в git НЕ коммитится — см. .gitignore)
# Секрет для HMAC сессий, минимум 32 символа: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://signal.example.ru
COOKIE_SECURE=1
# За reverse proxy (nginx) — для корректного IP в rate limit
TRUST_PROXY=1
# Пароль администратора при первом запуске (потом удалите строку). Если пусто — сгенерируется и выведется в консоль
ADMIN_PASSWORD=
# Проверка паролей по базе утечек Have I Been Pwned (k-анонимность)
HIBP_CHECK=1
# Исходящий вебхук Битрикс24 (содержит секрет!)
BITRIX24_WEBHOOK_URL=
# ТОЛЬКО для демонстрации (в production игнорируются):
# DEMO_LOGIN=1   — вход выбором роли без пароля
# DEMO_TOOLS=1   — сдвиг времени и сброс данных в админке
